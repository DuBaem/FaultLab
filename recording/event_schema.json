
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FaultLab Recorded Event",
  "description": "Validates events generated by the FaultLab scenario controller.",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "run_started",
        "fault_apply_started",
        "fault_applied",
        "fault_cleanup_started",
        "fault_cleaned",
        "run_failed",
        "emergency_cleanup_completed",
        "emergency_cleanup_failed",
        "run_completed"
      ]
    },
    "action_id": {"type": "string"},
    "fault_type": {
      "type": "string",
      "enum": [
        "latency",
        "packet_loss",
        "disconnect",
        "process_failure"
      ]
    },
    "target": {"type": "string"},
    "service": {"type": "string"},
    "planned_offset_seconds": {
      "type": "number",
      "minimum": 0
    },
    "observed_offset_seconds": {
      "type": "number",
      "minimum": 0
    },
    "parameters": {"type": "object"},
    "error": {"type": "string"},
    "error_type": {"type": "string"},
    "status": {"type": "string"},
    "description": {"type": "string"},
    "dry_run": {"type": "boolean"},
    "action_count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {"type": "string"}
  },
  "required": [
    "sequence",
    "timestamp_utc",
    "run_id",
    "scenario_id",
    "event_type"
  ],
  "additionalProperties": false
}
