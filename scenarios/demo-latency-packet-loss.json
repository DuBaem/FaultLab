{
  "schema_version": "1.0",
  "scenario_id": "report-two-network-demo",
  "description": "Demonstrate sequential latency and packet-loss faults against the local server.",
  "targets": [
    {
      "name": "api-server",
      "service": "server"
    }
  ],
  "actions": [
    {
      "id": "add-250ms-delay",
      "type": "latency",
      "target": "api-server",
      "start_after_seconds": 1,
      "duration_seconds": 4,
      "parameters": {
        "latency_ms": 250,
        "jitter_ms": 25
      }
    },
    {
      "id": "drop-25-percent",
      "type": "packet_loss",
      "target": "api-server",
      "start_after_seconds": 6,
      "duration_seconds": 4,
      "parameters": {
        "loss_percent": 25
      }
    }
  ],
  "expected_outcomes": [
    "Latency rises while the delay rule is active.",
    "Some requests fail while packet loss is active.",
    "Each qdisc rule is removed before the next action begins."
  ],
  "safety": {
    "scope": "local_docker_only",
    "cleanup_required": true,
    "max_total_duration_seconds": 15
  }
}
