{
  "schema_version": "1.0",
  "scenario_id": "server-process-failure-demo",
  "description": "Stop the local server process with SIGTERM and restart it after a bounded interval.",
  "targets": [
    {
      "name": "api-server",
      "service": "server"
    }
  ],
  "actions": [
    {
      "id": "terminate-server-process",
      "type": "process_failure",
      "target": "api-server",
      "start_after_seconds": 1,
      "duration_seconds": 5,
      "parameters": {
        "signal": "SIGTERM",
        "restart_after_seconds": 5
      }
    }
  ],
  "expected_outcomes": [
    "Requests fail while the server process is stopped.",
    "The server container restarts and returns to a healthy state."
  ],
  "safety": {
    "scope": "local_docker_only",
    "cleanup_required": true,
    "max_total_duration_seconds": 15
  }
}
